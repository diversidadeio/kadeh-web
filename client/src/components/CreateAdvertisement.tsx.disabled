import { useState } from "react";
import { trpc } from "@/lib/trpc";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { AlertCircle, CheckCircle, Loader2, Upload } from "lucide-react";


const PRODUCT_CATEGORIES = [
  "Alimentos",
  "Bebidas",
  "Higiene Pessoal",
  "Limpeza",
  "Eletrônicos",
  "Roupas",
  "Calçados",
  "Livros",
  "Brinquedos",
  "Esportes",
];



export function CreateAdvertisement() {
  const [step, setStep] = useState<"details" | "targeting" | "review">("details");
  const [imageFile, setImageFile] = useState<File | null>(null);
  const [imageUrl, setImageUrl] = useState("");
  const [isUploadingImage, setIsUploadingImage] = useState(false);

  const [formData, setFormData] = useState({
    title: "",
    description: "",
    productName: "",
    productCategory: "",
    adType: "product" as "product" | "promotion" | "store",
    duration: "7days" as "1day" | "3days" | "7days" | "14days",
    numberOfStores: 1,
    targetCategories: [] as string[],
    region: "",
  });

  // Fetch pricing plans
  const { data: pricingPlans } = trpc.ads.getPricingPlans.useQuery();

  // Create advertisement mutation
  const createAdMutation = trpc.ads.suggestCorrelatedCategories.useMutation({
    onSuccess: () => {
      setStep("details");
      setFormData({
        title: "",
        description: "",
        productName: "",
        productCategory: "",
        adType: "product",
        duration: "7days",
        numberOfStores: 1,
        targetCategories: [],
        region: "",
      });
      setImageUrl("");
      setImageFile(null);
    },
  });

  const handleImageUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setIsUploadingImage(true);
    try {
      const tempUrl = URL.createObjectURL(file);
      setImageUrl(tempUrl);
      setImageFile(file);
    } catch (error) {
      console.error("Error uploading image:", error);
    } finally {
      setIsUploadingImage(false);
    }
  };

  const handleCategorySelect = (category: string) => {
    setFormData((prev) => ({
      ...prev,
      targetCategories: prev.targetCategories.includes(category)
        ? prev.targetCategories.filter((c) => c !== category)
        : [...prev.targetCategories, category],
    }));
  };

  const handleSubmit = () => {
    if (!imageUrl) {
      alert("Por favor, faça upload de uma imagem");
      return;
    }

    createAdMutation.mutate({
      ...formData,
      imageUrl,
    });
  };

  const calculatePrice = () => {
    if (!pricingPlans) return 0;
    const plan = pricingPlans.find(
      (p: any) => p.duration === formData.duration && 
      p.minStores <= formData.numberOfStores && 
      formData.numberOfStores <= p.maxStores
    );
    return plan ? parseFloat(plan.pricePerStore) * formData.numberOfStores : 0;
  };

  return (
    <div className="space-y-6">
      <Tabs value={step} onValueChange={(v) => setStep(v as any)} className="w-full">
        <TabsList className="grid w-full grid-cols-3">
          <TabsTrigger value="details">Detalhes do Anúncio</TabsTrigger>
          <TabsTrigger value="targeting">Segmentação</TabsTrigger>
          <TabsTrigger value="review">Revisar & Pagar</TabsTrigger>
        </TabsList>

        {/* Details Tab */}
        <TabsContent value="details" className="space-y-4">
          <Card>
            <CardHeader>
              <CardTitle>Detalhes do Anúncio</CardTitle>
              <CardDescription>
                Preencha as informações básicas do seu anúncio
              </CardDescription>
            </CardHeader>
            <CardContent className="space-y-4">
              <div>
                <label className="block text-sm font-medium mb-2">Tipo de Anúncio *</label>
                <div className="flex gap-4">
                  {(["product", "promotion", "store"] as const).map((type) => (
                    <label key={type} className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="radio"
                        name="adType"
                        value={type}
                        checked={formData.adType === type}
                        onChange={(e) =>
                          setFormData((prev) => ({
                            ...prev,
                            adType: e.target.value as any,
                          }))
                        }
                      />
                      <span className="text-sm">
                        {type === "product" && "Produto"}
                        {type === "promotion" && "Promoção"}
                        {type === "store" && "Loja"}
                      </span>
                    </label>
                  ))}
                </div>
              </div>

              <div>
                <label className="block text-sm font-medium mb-1">Título do Anúncio *</label>
                <Input
                  value={formData.title}
                  onChange={(e) =>
                    setFormData((prev) => ({ ...prev, title: e.target.value }))
                  }
                  placeholder="Ex: Promoção de Coca-Cola 2L"
                />
              </div>

              <div>
                <label className="block text-sm font-medium mb-1">Descrição</label>
                <textarea
                  value={formData.description}
                  onChange={(e) =>
                    setFormData((prev) => ({ ...prev, description: e.target.value }))
                  }
                  placeholder="Descreva seu anúncio"
                  className="w-full p-2 border rounded-md text-sm"
                  rows={3}
                />
              </div>

              <div>
                <label className="block text-sm font-medium mb-1">Nome do Produto</label>
                <Input
                  value={formData.productName}
                  onChange={(e) =>
                    setFormData((prev) => ({ ...prev, productName: e.target.value }))
                  }
                  placeholder="Ex: Coca-Cola 2L"
                />
              </div>

              <div>
                <label className="block text-sm font-medium mb-1">Categoria Principal *</label>
                <select
                  value={formData.productCategory}
                  onChange={(e) =>
                    setFormData((prev) => ({
                      ...prev,
                      productCategory: e.target.value,
                    }))
                  }
                  className="w-full p-2 border rounded-md text-sm"
                  required
                >
                  <option value="">Selecione uma categoria</option>
                  {PRODUCT_CATEGORIES.map((cat) => (
                    <option key={cat} value={cat}>
                      {cat}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label className="block text-sm font-medium mb-2">Imagem do Anúncio *</label>
                <div className="border-2 border-dashed rounded-lg p-6 text-center">
                  {imageUrl ? (
                    <div className="space-y-2">
                      <img
                        src={imageUrl}
                        alt="Preview"
                        className="w-32 h-32 object-cover mx-auto rounded"
                      />
                      <p className="text-sm text-green-600">Imagem carregada com sucesso</p>
                      <Button
                        type="button"
                        variant="outline"
                        size="sm"
                        onClick={() => {
                          setImageUrl("");
                          setImageFile(null);
                        }}
                      >
                        Trocar Imagem
                      </Button>
                    </div>
                  ) : (
                    <label className="cursor-pointer">
                      <Upload className="w-8 h-8 mx-auto mb-2 text-muted-foreground" />
                      <p className="text-sm font-medium">Clique para fazer upload</p>
                      <p className="text-xs text-muted-foreground">PNG, JPG até 5MB</p>
                      <input
                        type="file"
                        accept="image/*"
                        onChange={handleImageUpload}
                        className="hidden"
                        disabled={isUploadingImage}
                      />
                    </label>
                  )}
                </div>
              </div>

              <Button
                onClick={() => setStep("targeting")}
                disabled={!formData.title || !formData.productCategory || !imageUrl}
              >
                Próximo: Segmentação
              </Button>
            </CardContent>
          </Card>
        </TabsContent>

        {/* Targeting Tab */}
        <TabsContent value="targeting" className="space-y-4">
          <Card>
            <CardHeader>
              <CardTitle>Segmentação de Anúncios</CardTitle>
              <CardDescription>
                Selecione as categorias onde seu anúncio será exibido
              </CardDescription>
            </CardHeader>
            <CardContent className="space-y-4">
              <div>
                <label className="block text-sm font-medium mb-2">
                  Duração do Anúncio *
                </label>
                <div className="grid grid-cols-2 gap-2">
                  {(["1day", "3days", "7days", "14days"] as const).map((duration) => (
                    <button
                      key={duration}
                      onClick={() =>
                        setFormData((prev) => ({ ...prev, duration }))
                      }
                      className={`p-3 border rounded-lg text-sm font-medium transition ${
                        formData.duration === duration
                          ? "border-blue-500 bg-blue-50"
                          : "border-gray-200 hover:border-gray-300"
                      }`}
                    >
                      {duration === "1day" && "1 Dia"}
                      {duration === "3days" && "3 Dias"}
                      {duration === "7days" && "7 Dias"}
                      {duration === "14days" && "14 Dias"}
                    </button>
                  ))}
                </div>
              </div>

              <div>
                <label className="block text-sm font-medium mb-2">
                  Número de Lojas *
                </label>
                <Input
                  type="number"
                  min="1"
                  value={formData.numberOfStores}
                  onChange={(e) =>
                    setFormData((prev) => ({
                      ...prev,
                      numberOfStores: parseInt(e.target.value) || 1,
                    }))
                  }
                />
              </div>

              <div>
                <label className="block text-sm font-medium mb-2">
                  Categorias Correlacionadas
                </label>
                <p className="text-xs text-muted-foreground mb-3">
                  Selecione as categorias onde seu anúncio será exibido
                </p>
                <div className="space-y-2">
                  {PRODUCT_CATEGORIES.map((cat) => (
                    <label key={cat} className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.targetCategories.includes(cat)}
                        onChange={() => handleCategorySelect(cat)}
                      />
                      <span className="text-sm">{cat}</span>
                    </label>
                  ))}
                </div>
              </div>

              <div className="flex gap-2">
                <Button
                  variant="outline"
                  onClick={() => setStep("details")}
                >
                  Voltar
                </Button>
                <Button
                  onClick={() => setStep("review")}
                  disabled={formData.targetCategories.length === 0}
                >
                  Próximo: Revisar
                </Button>
              </div>
            </CardContent>
          </Card>
        </TabsContent>

        {/* Review Tab */}
        <TabsContent value="review" className="space-y-4">
          <Card>
            <CardHeader>
              <CardTitle>Revisar Anúncio</CardTitle>
              <CardDescription>
                Verifique os detalhes antes de confirmar o pagamento
              </CardDescription>
            </CardHeader>
            <CardContent className="space-y-4">
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <p className="text-sm text-muted-foreground">Título</p>
                  <p className="font-semibold">{formData.title}</p>
                </div>
                <div>
                  <p className="text-sm text-muted-foreground">Tipo</p>
                  <p className="font-semibold">
                    {formData.adType === "product" && "Produto"}
                    {formData.adType === "promotion" && "Promoção"}
                    {formData.adType === "store" && "Loja"}
                  </p>
                </div>
                <div>
                  <p className="text-sm text-muted-foreground">Duração</p>
                  <p className="font-semibold">
                    {formData.duration === "1day" && "1 Dia"}
                    {formData.duration === "3days" && "3 Dias"}
                    {formData.duration === "7days" && "7 Dias"}
                    {formData.duration === "14days" && "14 Dias"}
                  </p>
                </div>
                <div>
                  <p className="text-sm text-muted-foreground">Número de Lojas</p>
                  <p className="font-semibold">{formData.numberOfStores}</p>
                </div>
              </div>

              <div className="border-t pt-4">
                <p className="text-sm text-muted-foreground mb-2">Categorias Alvo</p>
                <div className="flex flex-wrap gap-2">
                  {formData.targetCategories.map((cat) => (
                    <span
                      key={cat}
                      className="inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm"
                    >
                      {cat}
                    </span>
                  ))}
                </div>
              </div>

              <div className="border-t pt-4 space-y-2">
                <div className="flex justify-between">
                  <span className="text-sm">Preço por Loja</span>
                  <span className="font-semibold">R$ {(calculatePrice() / formData.numberOfStores).toFixed(2)}</span>
                </div>
                <div className="flex justify-between text-lg font-bold border-t pt-2">
                  <span>Total</span>
                  <span>R$ {calculatePrice().toFixed(2)}</span>
                </div>
              </div>

              <div className="bg-blue-50 border border-blue-200 rounded-lg p-3">
                <p className="text-sm text-blue-700">
                  <strong>Posição de Prioridade:</strong> Seu anúncio será exibido na ordem de contratação.
                  Você verá sua posição exata antes de confirmar o pagamento.
                </p>
              </div>

              <div className="flex gap-2">
                <Button
                  variant="outline"
                  onClick={() => setStep("targeting")}
                >
                  Voltar
                </Button>
                <Button
                  onClick={handleSubmit}
                  disabled={createAdMutation.isPending}
                  className="flex-1"
                >
                  {createAdMutation.isPending ? (
                    <>
                      <Loader2 className="w-4 h-4 mr-2 animate-spin" />
                      Processando...
                    </>
                  ) : (
                    "Confirmar e Pagar"
                  )}
                </Button>
              </div>

              {createAdMutation.isSuccess && (
                <div className="p-3 bg-green-50 border border-green-200 rounded-md text-green-700 text-sm flex items-center gap-2">
                  <CheckCircle className="w-4 h-4" />
                  Anúncio criado com sucesso! Redirecionando para pagamento...
                </div>
              )}

              {createAdMutation.isError && (
                <div className="p-3 bg-red-50 border border-red-200 rounded-md text-red-700 text-sm flex items-center gap-2">
                  <AlertCircle className="w-4 h-4" />
                  Erro ao criar anúncio. Tente novamente.
                </div>
              )}
            </CardContent>
          </Card>
        </TabsContent>
      </Tabs>
    </div>
  );
}
