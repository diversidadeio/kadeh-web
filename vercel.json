{
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/send-recovery",
      "destination": "/api/send-recovery"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "buildCommand": "pnpm run build:vercel",
  "installCommand": "pnpm install"
}
